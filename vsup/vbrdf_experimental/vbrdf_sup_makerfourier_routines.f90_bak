! ###############################################################
! #                                                             #
! #  MAKER Subroutines in this Module                           #
! #                                                             #
! #              VBRDF_General_MAKER                            #
! #              VBRDF_NewCM_MAKER                              #
! #              VBRDF_NewGCM_MAKER                             #
! #              VBRDF_SnowKB_MAKER                             #
! #                                                             #
! #  Fourier Subroutines in this Module                         #
! #                                                             #
! #              SCALING_FOURIER_ZERO (New, Version 2.7)        #
! #              VBRDF_FOURIER                                  #
! #                                                             #
! ###############################################################

!  5/5/22. Version 2.8.5. Experimental Version for NASA-LARC PCRTM team

!  Changes for Version 2.8
!  -----------------------

!  Allow for presence of Two new kernels. Set-up calls for them,

!  Version 2p8p1. 2019 Overhaul.
!  -----------------------------

!  In the Fourier routines--->

!     !@@ Rob Fix, 3/20/19. Bug: Lambertian case wrongly used NSTOKESSQ instead of 1
!     !@@ Rob Fix, 11/1/19. Bug: Cossin_Mask wrongly used, code replaced. Thanks to X.Xu (UMBC)
!     !@@ Rob Fix, 11/1/19. Recoded the BRDF emissivity case
!     !@@ Rob Fix, 11/1/19. Used the Dot-Product command throughout. NSTOKESSQ Dropped.

!  Version 2p8p3.
!  --------------

!  1/31/21, Version 2.8.3. Analytical Model for Snow BRDF.
!     -- New VLIDORT BRDF Kernel. First introduced to VLIDORT, 18 November 2020.
!     -- Kokhanovsky and Breon, IEEE GeoScience and Remote Sensing Letters, Vol 9(5), 928-932 (2012)
!     -- The three parameters (L and M are free parameters) are
!        1. The L-value, related to the snow grain diameter size. Units [mm]
!        2. The M-value, "directly proportional to the mass concentration of pollutants"
!        3. The Wavelength in Microns --> Imaginary part of the refractive index.

!  2/28/21, Version 3.8.3. Doublet geometry option added

!  7/28/21. Version 2.8.3. Some Changes
!    -- Half-Range azimuth integration introduced, now the default option. Controlled by parameter setting
!    -- Adjustment of +/- signs in Fourier-component sine-series settings. Validates against TestBed
!    -- MAXSTHALF_BRDF Dimensioning for CXE/SXE/BAX/EBRDFUNC/USER_EBRDFUNC arrays, replaced by MAXSTREAMS_BRDF

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

!  2/28/22. Version 2.8.5. Semi-analytical Snow BRDF kernel
!     -- RTS model (Ross-Thick-Snow) of A. Ding et al., Remote Sensing, 11, 1611 (2019).
!     -- Basic model is the ART (Asymptotic radiative transfer) model of Kokhanovsky and Breon
!     -- Use as replacement of the Roujean kernel in the usual MODIS 3-kernel configuration
!     -- Must be used in conjunction with Lambertian and Ross-Thick kernels
!     -- One free parameter

!  5/5/22. Version 2.8.5. Experimental Version for NASA-LARC PCRTM team
!     -- Formerly vbrdf_sup_routines_m.
!     -- Maker routines take core kernel calculations and scale or copy them
!     -- General Maker routines either copy core stuff or scale with ADD_FRESNEL_SCALING
!     -- Snow_BRDF and NEWCM/NewGCM Maker routines have their own scaling.
!     -- Fourier routines are not changed

      MODULE vbrdf_sup_makerfourier_routines_m

      USE vbrdf_sup_core_def_m
      USE vbrdf_sup_kernels_experimental_m, Only : ADD_FRESNEL_SCALING

      PRIVATE
      PUBLIC :: VBRDF_General_MAKER, VBRDF_SnowKB_MAKER, VBRDF_NewCM_MAKER, VBRDF_NewGCM_MAKER, &
                VBRDF_FOURIER, SCALING_FOURIER_ZERO

      CONTAINS


      SUBROUTINE VBRDF_General_MAKER &
         ( Core, DO_FRESNEL_SCALING, DO_FRESNEL_SCALAR, REFRAC_INDEX, NKER,   & ! Main inputs
           DO_WSA_SCALING, DO_BSA_SCALING, DO_HALF_RANGE, DO_FOURIER_USERSUN, & ! New line, Version 2.7
           DO_SOLAR_SOURCES, DO_USER_OBSGEOMS, DO_DOUBLET_GEOMETRY, DO_DBONLY,    & ! Doublet-geometry flag added, Version 2.8.2
           DO_USER_STREAMS, DO_SURFACE_EMISSION, NSTREAMS_BRDF, NBRDF_HALF, NSSQ, & ! Flags and Numbers
           SCALING_NSTREAMS, NSTREAMS, NBEAMS, N_USER_STREAMS, N_USER_RELAZMS,    & ! Numbers
           DBKERNEL_BRDFUNC, BRDFUNC, USER_BRDFUNC,                           & ! output
           BRDFUNC_0, USER_BRDFUNC_0, EBRDFUNC, USER_EBRDFUNC,                & ! output
           SCALING_BRDFUNC, SCALING_BRDFUNC_0  )                                ! output, New line, Version 2.7

!  1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag added to argument list

!  7/28/21. Some changes
!    -- Half-Range azimuth integration control input introduced (DO_HALF_RANGE)
!    -- MAXSTHALF_BRDF Dimensioning for CXE/SXE/EBRDFUNC/USER_EBRDFUNC arrays, replaced by MAXSTREAMS_BRDF

!  include file of dimensions and numbers
!    -- 7/28/21.  MAXSTHALF_BRDF Dimensioning dropped

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      USE VLIDORT_PARS_m, only : MAXBEAMS, MAX_USER_RELAZMS, MAX_USER_STREAMS, &
                                 MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS_SCALING, & 
                                 MAX_BRDF_PARAMETERS, MAXSTREAMS_BRDF,  ZERO

      IMPLICIT NONE

!  Prepares the bidirectional reflectance scatter matrices

!  Observational Geometry Inputs. Marked with !@@
!     Installed 31 december 2012.
!     Observation-Geometry input control.         (DO_USER_OBSGEOMS)
!     Added solar_sources flag for better control (DO_SOLAR_SOURCES)
!     Added Overall-exact flag for better control (DO_EXACT)

!  Input arguments
!  ===============

!  Input structure of Core and Help variables

      TYPE(VBRDF_Sup_Core), INTENT(IN)   :: Core

!  Fresnel inpouts (refractive index, flags)

      LOGICAL, INTENT(IN) ::          DO_FRESNEL_SCALING
      LOGICAL , INTENT(IN)::          DO_FRESNEL_SCALAR
      DOUBLE PRECISION, INTENT(IN) :: REFRAC_INDEX

!  Kernel Index

      INTEGER, INTENT(IN) ::          NKER

!  White-sky and Black-sky albedo scaling flags. New Version 2.7

      LOGICAL, INTENT(IN) ::          DO_WSA_SCALING
      LOGICAL, INTENT(IN) ::          DO_BSA_SCALING

!  7/28/21. Half-range integration variable introduced
!   -- if set, azimuthal range is [0,pi], if not set the range is [pi,pi]

      LOGICAL, INTENT(IN) ::          DO_HALF_RANGE

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      LOGICAL, INTENT(IN) ::          DO_FOURIER_USERSUN

!  Solar sources + Observational Geometry flag
!    - 1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag 

      LOGICAL, INTENT(IN) ::          DO_SOLAR_SOURCES
      LOGICAL, INTENT(IN) ::          DO_USER_OBSGEOMS
      LOGICAL, INTENT(IN) ::          DO_DOUBLET_GEOMETRY

!  Rob Fix 9/25/14. Two variables replaced
!   Flag for the Direct-bounce term, replaces former "EXACT" variables 
!   Exact flag (!@@) and Exact only flag --> no Fourier term calculations
!      LOGICAL ::          DO_EXACT
!      LOGICAL ::          DO_EXACTONLY
      LOGICAL, INTENT(IN) ::          DO_DBONLY

!  Local flags

      LOGICAL, INTENT(IN) ::          DO_USER_STREAMS
      LOGICAL, INTENT(IN) ::          DO_SURFACE_EMISSION

!  Number of Azimuth waudrature streams

      INTEGER, INTENT(IN) ::          NSTREAMS_BRDF
      INTEGER, INTENT(IN) ::          NBRDF_HALF

!  Local number of Stokes component matrix entries
!    value = 1 for most kernels, except GISS Cox-Munk

      INTEGER, INTENT(IN) ::          NSSQ

!  Local angle control

      INTEGER, INTENT(IN) ::          NSTREAMS
      INTEGER, INTENT(IN) ::          SCALING_NSTREAMS
      INTEGER, INTENT(IN) ::          NBEAMS
      INTEGER, INTENT(IN) ::          N_USER_STREAMS
      INTEGER, INTENT(IN) ::          N_USER_RELAZMS

!  Output BRDF functions
!  =====================

!  At quadrature (discrete ordinate) angles

      DOUBLE PRECISION :: BRDFUNC   ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: BRDFUNC_0 ( MAXSTOKES_SQ, MAXSTREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  At user-defined stream directions

      DOUBLE PRECISION :: USER_BRDFUNC   ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: USER_BRDFUNC_0 ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  Exact DB values

      DOUBLE PRECISION :: DBKERNEL_BRDFUNC ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAX_USER_RELAZMS, MAXBEAMS )

!  Values for Emissivity
!   -- 7/28/21. Necessary now to use MAXSTREAMS_BRDF here instead of MAXSTHALF_BRDF

      DOUBLE PRECISION :: EBRDFUNC      ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS_BRDF, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: USER_EBRDFUNC ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS_BRDF, MAXSTREAMS_BRDF )

!  Output for WSA/BSA scaling options. New, Version 2.7

      DOUBLE PRECISION :: SCALING_BRDFUNC  ( MAXSTREAMS_SCALING, MAXSTREAMS_SCALING, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: SCALING_BRDFUNC_0 ( MAXSTREAMS_SCALING, MAXSTREAMS_BRDF )

!  local variables
!  ---------------

      INTEGER ::            I, UI, J, K, KE, IB, NKE_RANGE
      INTEGER, PARAMETER :: LUM = 1
      INTEGER, PARAMETER :: LUA = 1
      DOUBLE PRECISION   :: VKERNEL(16)

!  Exact DB calculation
!  --------------------

!    !@@ Observational Geometry choice 12/31/12
!    !@@ Rob Fix 9/25/14. Always calculated for Solar Sources
!mick fix 9/19/2017 - initialize DBKERNEL_BRDFUNC

!  1/31/21. Version 2.8.3. Add doublet geometry option, in which the Exact-DB calculation
!   has the Azimuth angle coupled with the user zenith angle in a doublet.

      DBKERNEL_BRDFUNC = ZERO
      IF ( DO_FRESNEL_SCALING ) then
        IF ( DO_SOLAR_SOURCES ) THEN
          IF ( DO_USER_OBSGEOMS ) THEN
            DO IB = 1, NBEAMS
              CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,LUM,LUA,IB), DBKERNEL_BRDFUNC(:,LUM,LUA,IB)  )
            ENDDO
          ELSE IF ( DO_DOUBLET_GEOMETRY ) THEN
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS
              CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,LUA,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,LUA,IB), DBKERNEL_BRDFUNC(:,UI,LUA,IB)  )
            ENDDO ; ENDDO
          ELSE
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, N_USER_RELAZMS
              CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,K,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,K,IB), DBKERNEL_BRDFUNC(:,UI,K,IB)  )
            ENDDO ; ENDDO ; ENDDO
          END IF
        END IF
      ELSE
        IF ( DO_SOLAR_SOURCES ) THEN
          IF ( DO_USER_OBSGEOMS ) THEN
            DBKERNEL_BRDFUNC(1,LUM,LUA,1:NBEAMS) = Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,1:NBEAMS)
          ELSE IF ( DO_DOUBLET_GEOMETRY ) THEN
            DO UI = 1, N_USER_STREAMS
              DBKERNEL_BRDFUNC(1,UI,LUA,1:NBEAMS) = Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,LUA,1:NBEAMS)
            ENDDO
          ELSE
            DO K = 1, N_USER_RELAZMS ; DO UI = 1, N_USER_STREAMS
              DBKERNEL_BRDFUNC(1,UI,K,1:NBEAMS) = Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,K,1:NBEAMS)
            ENDDO ; ENDDO
          END IF
        ENDIF
      ENDIF

!  SCALING OPTIONS (New Section, Version 2.7)
!  ------------------------------------------

!  White-sky albedo, scaling. Only requires the (1,1) component
!     Use Local "Scaling_streams", both incident and outgoing

      IF ( DO_WSA_SCALING ) THEN
        IF ( DO_FRESNEL_SCALING ) THEN
          DO I = 1, SCALING_NSTREAMS ; DO J = 1, SCALING_NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, 1, Core%SCALING_BRDFUNC_CORE(NKER,I,J,K), &
                     Core%SCALING_BRDFUNC_HELP(NKER,1,I,J,K), VKERNEL )
            SCALING_BRDFUNC(I,J,K) = VKERNEL(1)
          ENDDO ; ENDDO ; ENDDO
        ELSE
          DO I = 1, SCALING_NSTREAMS ; DO J = 1, SCALING_NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            SCALING_BRDFUNC(I,J,K) = Core%SCALING_BRDFUNC_CORE(NKER,I,J,K)
          ENDDO ; ENDDO ; ENDDO
        ENDIF
      ENDIF

!  Black-sky albedo, scaling. Only requires the (1,1) component
!     Use Local "Scaling_streams" for outgoing, solar beam for incoming (IB = 1)

      IF ( DO_BSA_SCALING .and. DO_SOLAR_SOURCES ) THEN
        IF ( DO_FRESNEL_SCALING ) THEN
          DO I = 1, SCALING_NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, 1, Core%SCALING_BRDFUNC_0_CORE(NKER,I,K), &
                     Core%SCALING_BRDFUNC_0_HELP(NKER,1,I,K), VKERNEL )
            SCALING_BRDFUNC_0(I,K) = VKERNEL(1)
          ENDDO ; ENDDO
        ELSE
          DO I = 1, SCALING_NSTREAMS ;  DO K = 1, NSTREAMS_BRDF
            SCALING_BRDFUNC_0(I,K) = Core%SCALING_BRDFUNC_0_CORE(NKER,I,K)
          ENDDO  ; ENDDO
        ENDIF
      ENDIF

!  Return if the Direct-bounce BRDF is all that is required (scaled or not!)

      IF ( DO_DBONLY ) RETURN

!  Quadrature outgoing directions
!  ------------------------------

!  Incident Solar beam
!    !@@  Solar Optionality. 12/31/12

      IF ( DO_SOLAR_SOURCES ) THEN
        if ( DO_FRESNEL_SCALING ) THEN
          DO IB = 1, NBEAMS ; DO I = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%BRDFUNC_0_CORE(NKER,I,IB,K), &
                     Core%BRDFUNC_0_HELP(NKER,1,I,IB,K), BRDFUNC_0(:,I,IB,K)  )
          ENDDO ; ENDDO ; ENDDO
        ELSE
          DO IB = 1, NBEAMS ; DO I = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            BRDFUNC_0(1,I,IB,K) = Core%BRDFUNC_0_CORE(NKER,I,IB,K)
          ENDDO ; ENDDO ; ENDDO
        ENDIF
      ENDIF

!  incident quadrature directions

      if ( DO_FRESNEL_SCALING ) THEN
        DO I = 1, NSTREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
          CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%BRDFUNC_CORE(NKER,I,J,K), &
                     Core%BRDFUNC_HELP(NKER,1,I,J,K), BRDFUNC(:,I,J,K)  )
        ENDDO ; ENDDO ; ENDDO
      ELSE
        DO I = 1, NSTREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
          BRDFUNC(1,I,J,K) = Core%BRDFUNC_CORE(NKER,I,J,K)
        ENDDO ; ENDDO ; ENDDO
      ENDIF

!  Emissivity (optional) - BRDF quadrature input directions
!    - 7/28/21. Use the HALF_RANGE flag to set the number of azimuth points NKE_RANGE.

      IF ( DO_SURFACE_EMISSION ) THEN
        NKE_RANGE = NSTREAMS_BRDF ; if (.not. DO_HALF_RANGE ) NKE_RANGE = NBRDF_HALF
        IF ( DO_FRESNEL_SCALING ) THEN
          DO I = 1, NSTREAMS ; DO KE = 1, NKE_RANGE ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%EBRDFUNC_CORE(NKER,I,KE,K), &
                     Core%EBRDFUNC_HELP(NKER,1,I,KE,K), EBRDFUNC(:,I,KE,K)  )
          ENDDO ; ENDDO ; ENDDO
        ELSE
          DO I = 1, NSTREAMS ; DO KE = 1, NKE_RANGE ; DO K = 1, NSTREAMS_BRDF
            EBRDFUNC(1,I,KE,K) = Core%EBRDFUNC_CORE(NKER,I,KE,K)
          ENDDO ; ENDDO ; ENDDO
        ENDIF
      ENDIF

!  User-streams outgoing directions
!  --------------------------------

!  Incident Solar beam, Outgoing User-stream
!    !@@ Observational Geometry choice + Solar Optionality. 12/31/12

!  2/25/22. Version 2.8.5. This is now optional (add do_FOURIER_USERSUN flag)

      IF ( DO_USER_STREAMS .and. DO_SOLAR_SOURCES .and. do_FOURIER_USERSUN) THEN
        IF ( DO_FRESNEL_SCALING ) THEN
          IF ( DO_USER_OBSGEOMS ) THEN
            DO IB = 1, NBEAMS ; DO K = 1, NSTREAMS_BRDF
              CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%USER_BRDFUNC_0_CORE(NKER,LUM,IB,K), &
                     Core%USER_BRDFUNC_0_HELP(NKER,1,LUM,IB,K), USER_BRDFUNC_0(1,LUM,IB,K) )
            ENDDO ; ENDDO
          ELSE
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, NSTREAMS_BRDF
              CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%USER_BRDFUNC_0_CORE(NKER,UI,IB,K), &
                     Core%USER_BRDFUNC_0_HELP(NKER,1,UI,IB,K), USER_BRDFUNC_0(1,UI,IB,K) )
            ENDDO ; ENDDO ; ENDDO
          ENDIF
        ELSE
          IF ( DO_USER_OBSGEOMS ) THEN
            DO IB = 1, NBEAMS ; DO K = 1, NSTREAMS_BRDF
              USER_BRDFUNC_0(1,LUM,IB,K) = Core%USER_BRDFUNC_0_CORE(NKER,LUM,IB,K)
            ENDDO ; ENDDO
          ELSE
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, NSTREAMS_BRDF
              USER_BRDFUNC_0(1,UI,IB,K) = Core%USER_BRDFUNC_0_CORE(NKER,UI,IB,K)
            ENDDO ; ENDDO ; ENDDO
          ENDIF
        ENDIF
      ENDIF

!  incident quadrature directions, Outgoing User-stream

      IF ( DO_USER_STREAMS .and. DO_SOLAR_SOURCES ) THEN
        IF ( DO_FRESNEL_SCALING ) THEN
          DO UI = 1, N_USER_STREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%USER_BRDFUNC_CORE(NKER,UI,J,K), &
                     Core%USER_BRDFUNC_HELP(NKER,1,UI,J,K), USER_BRDFUNC(1,UI,J,K) )
          ENDDO ; ENDDO ; ENDDO
        ELSE
          DO UI = 1, N_USER_STREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            USER_BRDFUNC(1,UI,J,K) = Core%USER_BRDFUNC_CORE(NKER,UI,J,K)
          ENDDO ; ENDDO ; ENDDO
        ENDIF
      ENDIF

!  Emissivity (optional) - BRDF quadrature input directions
!  7/28/21. Use the HALF_RANGE flag to set the number of azimth points NKE_RANGE.

      IF ( DO_USER_STREAMS .and. DO_SURFACE_EMISSION ) THEN
        NKE_RANGE = NSTREAMS_BRDF ; if (.not. DO_HALF_RANGE ) NKE_RANGE = NBRDF_HALF
        IF ( DO_FRESNEL_SCALING ) THEN
          DO UI = 1, N_USER_STREAMS ; DO KE = 1, NKE_RANGE ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refrac_index, DO_FRESNEL_SCALAR, NSSQ, Core%USER_EBRDFUNC_CORE(NKER,UI,KE,K), &
                     Core%USER_EBRDFUNC_HELP(NKER,1,UI,KE,K), USER_EBRDFUNC(1,UI,KE,K) )
          ENDDO ; ENDDO ; ENDDO
        ELSE
          DO UI = 1, N_USER_STREAMS ; DO KE = 1, NKE_RANGE ; DO K = 1, NSTREAMS_BRDF
            USER_EBRDFUNC(1,UI,KE,K) = Core%USER_EBRDFUNC_CORE(NKER,UI,KE,K)
          ENDDO ; ENDDO ; ENDDO
        ENDIF
      ENDIF

!  Finish

      RETURN
      END SUBROUTINE VBRDF_General_MAKER

!

      SUBROUTINE VBRDF_SnowKB_MAKER &
         ( Core, Alpha, NKER,                                                 & ! Main inputs
           DO_WSA_SCALING, DO_BSA_SCALING, DO_HALF_RANGE, DO_FOURIER_USERSUN, & ! New line, Version 2.7
           DO_SOLAR_SOURCES, DO_USER_OBSGEOMS, DO_DOUBLET_GEOMETRY, DO_DBONLY,    & ! Doublet-geometry flag added, Version 2.8.2
           DO_USER_STREAMS, DO_SURFACE_EMISSION, NSTREAMS_BRDF, NBRDF_HALF,       & ! Flags and Numbers
           SCALING_NSTREAMS, NSTREAMS, NBEAMS, N_USER_STREAMS, N_USER_RELAZMS,    & ! Numbers
           DBKERNEL_BRDFUNC, BRDFUNC, USER_BRDFUNC,                           & ! output
           BRDFUNC_0, USER_BRDFUNC_0, EBRDFUNC, USER_EBRDFUNC,                & ! output
           SCALING_BRDFUNC, SCALING_BRDFUNC_0  )                                ! output, New line, Version 2.7

!  1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag added to argument list

!  7/28/21. Some changes
!    -- Half-Range azimuth integration control input introduced (DO_HALF_RANGE)
!    -- MAXSTHALF_BRDF Dimensioning for CXE/SXE/EBRDFUNC/USER_EBRDFUNC arrays, replaced by MAXSTREAMS_BRDF

!  include file of dimensions and numbers
!    -- 7/28/21.  MAXSTHALF_BRDF Dimensioning dropped

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      USE VLIDORT_PARS_m, only : MAXBEAMS, MAX_USER_RELAZMS, MAX_USER_STREAMS, &
                                 MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS_SCALING, & 
                                 MAX_BRDF_PARAMETERS, MAXSTREAMS_BRDF,  ZERO

      IMPLICIT NONE

!  Prepares the bidirectional reflectance scatter matrices

!  Observational Geometry Inputs. Marked with !@@
!     Installed 31 december 2012.
!     Observation-Geometry input control.         (DO_USER_OBSGEOMS)
!     Added solar_sources flag for better control (DO_SOLAR_SOURCES)
!     Added Overall-exact flag for better control (DO_EXACT)

!  Input arguments
!  ===============

!  Input structure of Core and Help variables

      TYPE(VBRDF_Sup_Core), INTENT(IN)   :: Core

!  Scaling input

      DOUBLE PRECISION, INTENT(IN) :: ALPHA

!  Kernel Index

      INTEGER, INTENT(IN) ::          NKER

!  White-sky and Black-sky albedo scaling flags. New Version 2.7

      LOGICAL, INTENT(IN) ::          DO_WSA_SCALING
      LOGICAL, INTENT(IN) ::          DO_BSA_SCALING

!  7/28/21. Half-range integration variable introduced
!   -- if set, azimuthal range is [0,pi], if not set the range is [pi,pi]

      LOGICAL, INTENT(IN) ::          DO_HALF_RANGE

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      LOGICAL, INTENT(IN) ::          DO_FOURIER_USERSUN

!  Solar sources + Observational Geometry flag
!    - 1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag 

      LOGICAL, INTENT(IN) ::          DO_SOLAR_SOURCES
      LOGICAL, INTENT(IN) ::          DO_USER_OBSGEOMS
      LOGICAL, INTENT(IN) ::          DO_DOUBLET_GEOMETRY

!  Rob Fix 9/25/14. Two variables replaced
!   Flag for the Direct-bounce term, replaces former "EXACT" variables 
!   Exact flag (!@@) and Exact only flag --> no Fourier term calculations
!      LOGICAL ::          DO_EXACT
!      LOGICAL ::          DO_EXACTONLY
      LOGICAL, INTENT(IN) ::          DO_DBONLY

!  Local flags

      LOGICAL, INTENT(IN) ::          DO_USER_STREAMS
      LOGICAL, INTENT(IN) ::          DO_SURFACE_EMISSION

!  Number of Azimuth waudrature streams

      INTEGER, INTENT(IN) ::          NSTREAMS_BRDF
      INTEGER, INTENT(IN) ::          NBRDF_HALF

!  Local angle control

      INTEGER, INTENT(IN) ::          NSTREAMS
      INTEGER, INTENT(IN) ::          NBEAMS
      INTEGER, INTENT(IN) ::          N_USER_STREAMS
      INTEGER, INTENT(IN) ::          N_USER_RELAZMS
      INTEGER, INTENT(IN) ::          SCALING_NSTREAMS

!  Output BRDF functions
!  =====================

!  At quadrature (discrete ordinate) angles

      DOUBLE PRECISION :: BRDFUNC   ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: BRDFUNC_0 ( MAXSTOKES_SQ, MAXSTREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  At user-defined stream directions

      DOUBLE PRECISION :: USER_BRDFUNC   ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: USER_BRDFUNC_0 ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  Exact DB values

      DOUBLE PRECISION :: DBKERNEL_BRDFUNC ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAX_USER_RELAZMS, MAXBEAMS )

!  Values for Emissivity
!   -- 7/28/21. Necessary now to use MAXSTREAMS_BRDF here instead of MAXSTHALF_BRDF

      DOUBLE PRECISION :: EBRDFUNC      ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS_BRDF, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: USER_EBRDFUNC ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS_BRDF, MAXSTREAMS_BRDF )

!  Output for WSA/BSA scaling options. New, Version 2.7

      DOUBLE PRECISION :: SCALING_BRDFUNC  ( MAXSTREAMS_SCALING, MAXSTREAMS_SCALING, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: SCALING_BRDFUNC_0 ( MAXSTREAMS_SCALING, MAXSTREAMS_BRDF )

!  local variables
!  ---------------

      INTEGER ::            I, UI, J, K, KE, IB, NKE_RANGE
      INTEGER, PARAMETER :: LUM = 1
      INTEGER, PARAMETER :: LUA = 1
      DOUBLE PRECISION   :: R0, KPROD, ARGUM, SCALING
      DOUBLE PRECISION, parameter :: CRITEXP = 88.0d0

!  Exact DB calculation
!  --------------------

!    !@@ Observational Geometry choice 12/31/12
!    !@@ Rob Fix 9/25/14. Always calculated for Solar Sources
!mick fix 9/19/2017 - initialize DBKERNEL_BRDFUNC

!  1/31/21. Version 2.8.3. Add doublet geometry option, in which the Exact-DB calculation
!   has the Azimuth angle coupled with the user zenith angle in a doublet.

!  Alternative does exist. >FOr example, could use the subroutine
!      CALL SNOWMODELBRDF_SCALING ( ALPHA, Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,IB), &
!              Core%DBKERNEL_BRDFUNC_HELP(NKER,1,LUM,LUA,IB), DBKERNEL_BRDFUNC(1,LUM,LUA,IB) )

      DBKERNEL_BRDFUNC = ZERO
      IF ( DO_SOLAR_SOURCES ) THEN
         IF ( DO_USER_OBSGEOMS ) THEN
            DO IB = 1, NBEAMS
               R0    = Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,IB)
               KPROD = Core%DBKERNEL_BRDFUNC_HELP(NKER,1,LUM,LUA,IB)
               ARGUM = alpha * KProd / R0
               SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
               DBKERNEL_BRDFUNC(1,LUM,LUA,IB) = R0 * SCALING
            ENDDO
         ELSE IF ( DO_DOUBLET_GEOMETRY ) THEN
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS
               R0    = Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,LUA,IB)
               KPROD = Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,LUA,IB)
               ARGUM = alpha * KProd / R0
               SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
               DBKERNEL_BRDFUNC(1,UI,LUA,IB) = R0 * SCALING
            ENDDO ; ENDDO
         ELSE
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, N_USER_RELAZMS
               R0    = Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,K,IB)
               KPROD = Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,K,IB)
               ARGUM = alpha * KProd / R0
               SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
               DBKERNEL_BRDFUNC(1,UI,K,IB) = R0 * SCALING
            ENDDO ; ENDDO ; ENDDO
         END IF
      ENDIF

!  SCALING OPTIONS (New Section, Version 2.7)
!  ------------------------------------------

!  White-sky albedo, scaling. Only requires the (1,1) component
!     Use Local "Scaling_streams", both incident and outgoing

      IF ( DO_WSA_SCALING ) THEN
         DO I = 1, SCALING_NSTREAMS ; DO J = 1, SCALING_NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            R0    = Core%SCALING_BRDFUNC_CORE(NKER,I,J,K)
            KPROD = Core%SCALING_BRDFUNC_HELP(NKER,1,I,J,K)
            ARGUM = alpha * KProd / R0
            SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
            SCALING_BRDFUNC(I,J,K) = R0 * SCALING
         ENDDO ; ENDDO ; ENDDO
      ENDIF

!  Black-sky albedo, scaling. Only requires the (1,1) component
!     Use Local "Scaling_streams" for outgoing, solar beam for incoming (IB = 1)

      IF ( DO_BSA_SCALING .and. DO_SOLAR_SOURCES ) THEN
         DO I = 1, SCALING_NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            R0    = Core%SCALING_BRDFUNC_0_CORE(NKER,I,K)
            KPROD = Core%SCALING_BRDFUNC_0_HELP(NKER,1,I,K)
            ARGUM = alpha * KProd / R0
            SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
            SCALING_BRDFUNC_0(I,K) = R0 * SCALING
         ENDDO ; ENDDO
      ENDIF

!  Return if the Direct-bounce BRDF is all that is required (scaled or not!)

      IF ( DO_DBONLY ) RETURN

!  Quadrature outgoing directions
!  ------------------------------

!  Incident Solar beam
!    !@@  Solar Optionality. 12/31/12

      IF ( DO_SOLAR_SOURCES ) THEN
         DO IB = 1, NBEAMS ; DO I = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            R0    = Core%BRDFUNC_0_CORE(NKER,I,IB,K)
            KPROD = Core%BRDFUNC_0_HELP(NKER,1,I,IB,K)
            ARGUM = alpha * KProd / R0
            SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
            BRDFUNC_0(1,I,IB,K) = R0 * SCALING
         ENDDO ; ENDDO ; ENDDO
      ENDIF

!  incident quadrature directions

      DO I = 1, NSTREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
         R0    = Core%BRDFUNC_CORE(NKER,I,J,K)
         KPROD = Core%BRDFUNC_HELP(NKER,1,I,J,K)
         ARGUM = alpha * KProd / R0
         SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
         BRDFUNC(1,I,J,K) = R0 * SCALING
      ENDDO ; ENDDO ; ENDDO

!  Emissivity (optional) - BRDF quadrature input directions
!    - 7/28/21. Use the HALF_RANGE flag to set the number of azimuth points NKE_RANGE.

      IF ( DO_SURFACE_EMISSION ) THEN
         NKE_RANGE = NSTREAMS_BRDF ; if (.not. DO_HALF_RANGE ) NKE_RANGE = NBRDF_HALF
         DO I = 1, NSTREAMS ; DO KE = 1, NKE_RANGE ; DO K = 1, NSTREAMS_BRDF
            R0    = Core%EBRDFUNC_CORE(NKER,I,KE,K)
            KPROD = Core%EBRDFUNC_HELP(NKER,1,I,KE,K)
            ARGUM = alpha * KProd / R0
            SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
            EBRDFUNC(1,I,KE,K) = R0 * SCALING
         ENDDO ; ENDDO ; ENDDO
      ENDIF

!  User-streams outgoing directions
!  --------------------------------

!  Incident Solar beam, Outgoing User-stream
!    !@@ Observational Geometry choice + Solar Optionality. 12/31/12

!  2/25/22. Version 2.8.5. This is now optional (add do_FOURIER_USERSUN flag)

      IF ( DO_USER_STREAMS .and. DO_SOLAR_SOURCES .and. do_FOURIER_USERSUN) THEN
         IF ( DO_USER_OBSGEOMS ) THEN
            DO IB = 1, NBEAMS ; DO K = 1, NSTREAMS_BRDF
               R0    = Core%USER_BRDFUNC_0_CORE(NKER,LUM,IB,K)
               KPROD = Core%USER_BRDFUNC_0_HELP(NKER,1,LUM,IB,K)
               ARGUM = alpha * KProd / R0
               SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
               USER_BRDFUNC_0(1,LUM,IB,K) = R0 * SCALING
            ENDDO ; ENDDO
         ELSE
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, NSTREAMS_BRDF
               R0    = Core%USER_BRDFUNC_0_CORE(NKER,UI,IB,K)
               KPROD = Core%USER_BRDFUNC_0_HELP(NKER,1,UI,IB,K)
               ARGUM = alpha * KProd / R0
               SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
               USER_BRDFUNC_0(1,UI,IB,K) = R0 * SCALING
            ENDDO ; ENDDO ; ENDDO
         ENDIF
      ENDIF

!  incident quadrature directions, Outgoing User-stream

      IF ( DO_USER_STREAMS .and. DO_SOLAR_SOURCES ) THEN
         DO UI = 1, N_USER_STREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            R0    = Core%USER_BRDFUNC_CORE(NKER,UI,J,K)
            KPROD = Core%USER_BRDFUNC_HELP(NKER,1,UI,J,K)
            ARGUM = alpha * KProd / R0
            SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
            USER_BRDFUNC(1,UI,J,K) = R0 * SCALING
         ENDDO ; ENDDO ; ENDDO
      ENDIF

!  Emissivity (optional) - BRDF quadrature input directions
!  7/28/21. Use the HALF_RANGE flag to set the number of azimth points NKE_RANGE.

      IF ( DO_USER_STREAMS .and. DO_SURFACE_EMISSION ) THEN
         NKE_RANGE = NSTREAMS_BRDF ; if (.not. DO_HALF_RANGE ) NKE_RANGE = NBRDF_HALF
         DO UI = 1, N_USER_STREAMS ; DO KE = 1, NKE_RANGE ; DO K = 1, NSTREAMS_BRDF
            R0    = Core%USER_EBRDFUNC_CORE(NKER,UI,KE,K)
            KPROD = Core%USER_EBRDFUNC_HELP(NKER,1,UI,KE,K)
            ARGUM = alpha * KProd / R0
            SCALING = ZERO; if ( ARGUM .lt. CRITEXP ) SCALING = EXP ( - ARGUM ) 
            USER_EBRDFUNC(1,UI,KE,K) = R0 * SCALING
         ENDDO ; ENDDO ; ENDDO
      ENDIF

!  Finish

      RETURN
      END SUBROUTINE VBRDF_SnowKB_MAKER

!

      SUBROUTINE VBRDF_NewCM_MAKER &
         ( Core, WC_correction, WC_Reflectance, RefIdx, NKER, DO_FOURIER_USERSUN, & ! New line, Version 2.7
           DO_USER_OBSGEOMS, DO_DOUBLET_GEOMETRY, DO_USER_STREAMS, DO_DBONLY,     & ! Input flags
           NSTREAMS_BRDF, NSTREAMS, NBEAMS, N_USER_STREAMS, N_USER_RELAZMS,       & ! Input numbers
           DBKERNEL_BRDFUNC, BRDFUNC, USER_BRDFUNC,                               & ! output
           BRDFUNC_0, USER_BRDFUNC_0 )                                              ! output, New line, Version 2.7

!  1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag added to argument list

!  7/28/21. Some changes
!    -- Half-Range azimuth integration control input introduced (DO_HALF_RANGE)
!    -- MAXSTHALF_BRDF Dimensioning for CXE/SXE/EBRDFUNC/USER_EBRDFUNC arrays, replaced by MAXSTREAMS_BRDF

!  include file of dimensions and numbers
!    -- 7/28/21.  MAXSTHALF_BRDF Dimensioning dropped

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      USE VLIDORT_PARS_m, only : MAXBEAMS, MAX_USER_RELAZMS, MAX_USER_STREAMS, &
                                 MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS_SCALING, & 
                                 MAX_BRDF_PARAMETERS, MAXSTREAMS_BRDF,  ZERO

      IMPLICIT NONE

!  Prepares the bidirectional reflectance scatter matrices

!  Observational Geometry Inputs. Marked with !@@
!     Installed 31 december 2012.
!     Observation-Geometry input control.         (DO_USER_OBSGEOMS)
!     Added solar_sources flag for better control (DO_SOLAR_SOURCES)
!     Added Overall-exact flag for better control (DO_EXACT)

!  Input arguments
!  ===============

!  Input structure of Core and Help variables

      TYPE(VBRDF_Sup_Core), INTENT(IN)   :: Core

!  Foam and refractive index input

      DOUBLE PRECISION, Intent(in) :: WC_correction, WC_Reflectance, Refidx

!  Kernel Index

      INTEGER, Intent(in) ::          NKER

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      LOGICAL, Intent(in) ::          DO_FOURIER_USERSUN

!  Solar sources + Observational Geometry flag
!    - 1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag 

      LOGICAL, Intent(in) ::          DO_USER_OBSGEOMS
      LOGICAL, Intent(in) ::          DO_DOUBLET_GEOMETRY
      LOGICAL, Intent(in) ::          DO_USER_STREAMS

!   Flag for the Direct-bounce term, replaces former "EXACT" variables 

      LOGICAL, Intent(in) ::          DO_DBONLY

!  Number of Azimuth quadrature streams

      INTEGER, Intent(in) ::          NSTREAMS_BRDF

!  Local Angle control

      INTEGER, Intent(in) ::          NSTREAMS
      INTEGER, Intent(in) ::          NBEAMS
      INTEGER, Intent(in) ::          N_USER_STREAMS
      INTEGER, Intent(in) ::          N_USER_RELAZMS

!  Output BRDF functions
!  =====================

!  Exact DB values

      DOUBLE PRECISION :: DBKERNEL_BRDFUNC ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAX_USER_RELAZMS, MAXBEAMS )

!  At quadrature (discrete ordinate) angles

      DOUBLE PRECISION :: BRDFUNC   ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: BRDFUNC_0 ( MAXSTOKES_SQ, MAXSTREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  At user-defined stream directions

      DOUBLE PRECISION :: USER_BRDFUNC   ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: USER_BRDFUNC_0 ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  local variables
!  ---------------

      INTEGER ::            I, UI, J, K, IB
      INTEGER, PARAMETER :: LUM = 1
      INTEGER, PARAMETER :: LUA = 1
      LOGICAL            :: Scalar = .true.
      DOUBLE PRECISION   :: VKERNEL(16)

!  Exact DB calculation
!  --------------------

!    !@@ Observational Geometry choice 12/31/12
!    !@@ Rob Fix 9/25/14. Always calculated for Solar Sources
!mick fix 9/19/2017 - initialize DBKERNEL_BRDFUNC

!  1/31/21. Version 2.8.3. Add doublet geometry option, in which the Exact-DB calculation
!   has the Azimuth angle coupled with the user zenith angle in a doublet.

!  Alternative does exist. >FOr example, could use the subroutine
!      CALL SNOWMODELBRDF_SCALING ( ALPHA, Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,IB), &
!              Core%DBKERNEL_BRDFUNC_HELP(NKER,1,LUM,LUA,IB), DBKERNEL_BRDFUNC(1,LUM,LUA,IB) )

      DBKERNEL_BRDFUNC = ZERO
      IF ( DO_USER_OBSGEOMS ) THEN
         DO IB = 1, NBEAMS
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,LUM,LUA,IB), VKERNEL )
            DBKERNEL_BRDFUNC(1,LUM,LUA,IB) = WC_Reflectance + WC_correction * VKERNEL(1)
         ENDDO
      ELSE IF ( DO_DOUBLET_GEOMETRY ) THEN
         DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,LUA,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,LUA,IB), VKERNEL ) 
            DBKERNEL_BRDFUNC(1,UI,LUA,IB) = WC_Reflectance + WC_correction * VKERNEL(1)
         ENDDO ; ENDDO
      ELSE
         DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, N_USER_RELAZMS
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,K,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,K,IB), VKERNEL )
            DBKERNEL_BRDFUNC(1,UI,K,IB) = WC_Reflectance + WC_correction * VKERNEL(1)
         ENDDO ; ENDDO ; ENDDO
      END IF

!  Return if the Direct-bounce BRDF is all that is required (scaled or not!)

      IF ( DO_DBONLY ) RETURN

!  Quadrature outgoing directions
!  ------------------------------

!  Incident Solar beam (always present)

      DO IB = 1, NBEAMS ; DO I = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
         CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%BRDFUNC_0_CORE(NKER,I,IB,K), &
                     Core%BRDFUNC_0_HELP(NKER,1,I,IB,K), VKERNEL )
         BRDFUNC_0(1,I,IB,K) = WC_Reflectance + WC_correction * VKERNEL(1)
      ENDDO ; ENDDO ; ENDDO

!  incident quadrature directions

      DO I = 1, NSTREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
         CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%BRDFUNC_CORE(NKER,I,J,K), &
                     Core%BRDFUNC_HELP(NKER,1,I,J,K), VKERNEL )
         BRDFUNC(1,I,J,K) = WC_Reflectance + WC_correction * VKERNEL(1)
      ENDDO ; ENDDO ; ENDDO

!  User-streams outgoing directions
!  --------------------------------

!  Incident Solar beam, Outgoing User-stream
!    !@@ Observational Geometry choice + Solar Optionality. 12/31/12

!  2/25/22. Version 2.8.5. This is now optional (add do_FOURIER_USERSUN flag)

      IF ( DO_USER_STREAMS .and. do_FOURIER_USERSUN) THEN
         IF ( DO_USER_OBSGEOMS ) THEN
            DO IB = 1, NBEAMS ; DO K = 1, NSTREAMS_BRDF
               CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%USER_BRDFUNC_0_CORE(NKER,LUM,IB,K), &
                     Core%USER_BRDFUNC_0_HELP(NKER,1,LUM,IB,K), VKERNEL )
               USER_BRDFUNC_0(1,LUM,IB,K) = WC_Reflectance + WC_correction * VKERNEL(1)
            ENDDO ; ENDDO
         ELSE
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, NSTREAMS_BRDF
               CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%USER_BRDFUNC_0_CORE(NKER,UI,IB,K), &
                     Core%USER_BRDFUNC_0_HELP(NKER,1,UI,IB,K), VKERNEL )
               USER_BRDFUNC_0(1,UI,IB,K) = WC_Reflectance + WC_correction * VKERNEL(1)
            ENDDO ; ENDDO ; ENDDO
         ENDIF
      ENDIF

!  incident quadrature directions, Outgoing User-stream

      IF ( DO_USER_STREAMS ) THEN
         DO UI = 1, N_USER_STREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, 1, Core%USER_BRDFUNC_CORE(NKER,UI,J,K), &
                     Core%USER_BRDFUNC_HELP(NKER,1,UI,J,K), VKERNEL )
            USER_BRDFUNC(1,UI,J,K) = WC_Reflectance + WC_correction * VKERNEL(1)
         ENDDO ; ENDDO ; ENDDO
      ENDIF

!  Finish

      RETURN
      END SUBROUTINE VBRDF_NewCM_MAKER

!

      SUBROUTINE VBRDF_NewGCM_MAKER &
         ( Core, WC_correction, WC_Reflectance, RefIdx, NKER, NSSQ, DO_FOURIER_USERSUN, & ! New line, Version 2.7
           DO_USER_OBSGEOMS, DO_DOUBLET_GEOMETRY, DO_USER_STREAMS, DO_DBONLY,           & ! Input flags
           NSTREAMS_BRDF, NSTREAMS, NBEAMS, N_USER_STREAMS, N_USER_RELAZMS,             & ! Input numbers
           DBKERNEL_BRDFUNC, BRDFUNC, USER_BRDFUNC,                                     & ! output
           BRDFUNC_0, USER_BRDFUNC_0 )                                                    ! output, New line, Version 2.7

!  1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag added to argument list

!  7/28/21. Some changes
!    -- Half-Range azimuth integration control input introduced (DO_HALF_RANGE)
!    -- MAXSTHALF_BRDF Dimensioning for CXE/SXE/EBRDFUNC/USER_EBRDFUNC arrays, replaced by MAXSTREAMS_BRDF

!  include file of dimensions and numbers
!    -- 7/28/21.  MAXSTHALF_BRDF Dimensioning dropped

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      USE VLIDORT_PARS_m, only : MAXBEAMS, MAX_USER_RELAZMS, MAX_USER_STREAMS, &
                                 MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS_SCALING, & 
                                 MAX_BRDF_PARAMETERS, MAXSTREAMS_BRDF, ZERO, ONE

      IMPLICIT NONE

!  Prepares the bidirectional reflectance scatter matrices

!  Observational Geometry Inputs. Marked with !@@
!     Installed 31 december 2012.
!     Observation-Geometry input control.         (DO_USER_OBSGEOMS)
!     Added solar_sources flag for better control (DO_SOLAR_SOURCES)
!     Added Overall-exact flag for better control (DO_EXACT)

!  Input arguments
!  ===============

!  Input structure of Core and Help variables

      TYPE(VBRDF_Sup_Core), INTENT(IN)   :: Core

!  Foam and refractive index input

      DOUBLE PRECISION, Intent(in) :: WC_correction, WC_Reflectance, Refidx

!  Kernel Index

      INTEGER, Intent(in) ::          NKER

!  Number of Stokes components

      INTEGER, Intent(in) ::          NSSQ

!  2/25/22. Version 2.8.5. Increased flexibility.
!    -- Introduce flag DO_FOURIER_USERSUN for controlling calculation of USER_BRDF_F_0.

      LOGICAL, Intent(in) ::          DO_FOURIER_USERSUN

!  Solar sources + Observational Geometry flag
!    - 1/31/21. Version 2.8.3. DO_DOUBLET_GEOMETRY flag 

      LOGICAL, Intent(in) ::          DO_USER_OBSGEOMS
      LOGICAL, Intent(in) ::          DO_DOUBLET_GEOMETRY
      LOGICAL, Intent(in) ::          DO_USER_STREAMS

!   Flag for the Direct-bounce term, replaces former "EXACT" variables 

      LOGICAL, Intent(in) ::          DO_DBONLY

!  Number of Azimuth quadrature streams

      INTEGER, Intent(in) ::          NSTREAMS_BRDF

!  Local Angle control

      INTEGER, Intent(in) ::          NSTREAMS
      INTEGER, Intent(in) ::          NBEAMS
      INTEGER, Intent(in) ::          N_USER_STREAMS
      INTEGER, Intent(in) ::          N_USER_RELAZMS

!  Output BRDF functions
!  =====================

!  Exact DB values

      DOUBLE PRECISION :: DBKERNEL_BRDFUNC ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAX_USER_RELAZMS, MAXBEAMS )

!  At quadrature (discrete ordinate) angles

      DOUBLE PRECISION :: BRDFUNC   ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: BRDFUNC_0 ( MAXSTOKES_SQ, MAXSTREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  At user-defined stream directions

      DOUBLE PRECISION :: USER_BRDFUNC   ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: USER_BRDFUNC_0 ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXBEAMS, MAXSTREAMS_BRDF )

!  local variables
!  ---------------

      INTEGER ::            I, UI, J, K, IB, NSSQ_MASK(4), NSTOKES, NSM
      INTEGER, PARAMETER :: LUM = 1
      INTEGER, PARAMETER :: LUA = 1
      LOGICAL            :: Scalar = .false.
      DOUBLE PRECISION   :: VKERNEL(16), UNIKERNEL(16)

!   Define "NSTOKES squared" mask and associated upper limit NSM (redefines number
!   of elements from NewGCM kernel output arrays to pass to local output arrays
!   depending on the value of NSTOKES to fix some element-passing bugs)
!mick fix 11/14/2019 - added this section

      NSSQ_MASK = (/ 1,6,11,16 /)
      NSTOKES = INT(SQRT(REAL(NSSQ)))
      NSM = NSSQ_MASK(NSTOKES)
      UNIKERNEL(2:16) = ZERO ; UNIKERNEL(1) = ONE

!  Exact DB calculation
!  --------------------

!    !@@ Observational Geometry choice 12/31/12
!    !@@ Rob Fix 9/25/14. Always calculated for Solar Sources
!mick fix 9/19/2017 - initialize DBKERNEL_BRDFUNC

!  1/31/21. Version 2.8.3. Add doublet geometry option, in which the Exact-DB calculation
!   has the Azimuth angle coupled with the user zenith angle in a doublet.

!  Alternative does exist. >FOr example, could use the subroutine
!      CALL SNOWMODELBRDF_SCALING ( ALPHA, Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,IB), &
!              Core%DBKERNEL_BRDFUNC_HELP(NKER,1,LUM,LUA,IB), DBKERNEL_BRDFUNC(1,LUM,LUA,IB) )

      DBKERNEL_BRDFUNC = ZERO
      IF ( DO_USER_OBSGEOMS ) THEN
         DO IB = 1, NBEAMS
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%DBKERNEL_BRDFUNC_CORE(NKER,LUM,LUA,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,LUM,LUA,IB), VKERNEL )
            DBKERNEL_BRDFUNC(1:NSM,LUM,LUA,IB) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
         ENDDO
      ELSE IF ( DO_DOUBLET_GEOMETRY ) THEN
         DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,LUA,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,LUA,IB), VKERNEL ) 
            DBKERNEL_BRDFUNC(1:NSM,UI,LUA,IB) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
         ENDDO ; ENDDO
      ELSE
         DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, N_USER_RELAZMS
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%DBKERNEL_BRDFUNC_CORE(NKER,UI,K,IB), &
                     Core%DBKERNEL_BRDFUNC_HELP(NKER,1,UI,K,IB), VKERNEL )
            DBKERNEL_BRDFUNC(1:NSM,UI,K,IB) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
         ENDDO ; ENDDO ; ENDDO
      END IF

!  Return if the Direct-bounce BRDF is all that is required (scaled or not!)

      IF ( DO_DBONLY ) RETURN

!  Quadrature outgoing directions
!  ------------------------------

!  Incident Solar beam (always present)

      DO IB = 1, NBEAMS ; DO I = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
         CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%BRDFUNC_0_CORE(NKER,I,IB,K), &
                     Core%BRDFUNC_0_HELP(NKER,1,I,IB,K), VKERNEL )
         BRDFUNC_0(1:NSM,I,IB,K) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
      ENDDO ; ENDDO ; ENDDO

!  incident quadrature directions

      DO I = 1, NSTREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
         CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%BRDFUNC_CORE(NKER,I,J,K), &
                     Core%BRDFUNC_HELP(NKER,1,I,J,K), VKERNEL )
         BRDFUNC(1:NSM,I,J,K) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
      ENDDO ; ENDDO ; ENDDO

!  User-streams outgoing directions
!  --------------------------------

!  Incident Solar beam, Outgoing User-stream
!    !@@ Observational Geometry choice + Solar Optionality. 12/31/12

!  2/25/22. Version 2.8.5. This is now optional (add do_FOURIER_USERSUN flag)

      IF ( DO_USER_STREAMS .and. do_FOURIER_USERSUN) THEN
         IF ( DO_USER_OBSGEOMS ) THEN
            DO IB = 1, NBEAMS ; DO K = 1, NSTREAMS_BRDF
               CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%USER_BRDFUNC_0_CORE(NKER,LUM,IB,K), &
                     Core%USER_BRDFUNC_0_HELP(NKER,1,LUM,IB,K), VKERNEL )
               USER_BRDFUNC_0(1:NSM,LUM,IB,K) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
            ENDDO ; ENDDO
         ELSE
            DO IB = 1, NBEAMS ; DO UI = 1, N_USER_STREAMS ; DO K = 1, NSTREAMS_BRDF
               CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%USER_BRDFUNC_0_CORE(NKER,UI,IB,K), &
                     Core%USER_BRDFUNC_0_HELP(NKER,1,UI,IB,K), VKERNEL )
               USER_BRDFUNC_0(1:NSM,UI,IB,K) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
            ENDDO ; ENDDO ; ENDDO
         ENDIF
      ENDIF

!  incident quadrature directions, Outgoing User-stream

      IF ( DO_USER_STREAMS ) THEN
         DO UI = 1, N_USER_STREAMS ; DO J = 1, NSTREAMS ; DO K = 1, NSTREAMS_BRDF
            CALL ADD_FRESNEL_SCALING ( Refidx, Scalar, NSSQ, Core%USER_BRDFUNC_CORE(NKER,UI,J,K), &
                     Core%USER_BRDFUNC_HELP(NKER,1,UI,J,K), VKERNEL )
            USER_BRDFUNC(1:NSM,UI,J,K) = WC_Reflectance * UNIKERNEL(1:NSM) + WC_correction * VKERNEL(1:NSM)
         ENDDO ; ENDDO ; ENDDO
      ENDIF

!  Finish

      RETURN
      END SUBROUTINE VBRDF_NewGCM_MAKER

!

      SUBROUTINE SCALING_FOURIER_ZERO &
            ( DO_LOCAL_WSA, DO_LOCAL_BSA, LAMBERTIAN_FLAG,            &
              DO_HALF_RANGE, SCALING_NSTREAMS, NSTREAMS_BRDF, A_BRDF, &
              SCALING_BRDFUNC, SCALING_BRDFUNC_0,                     &
              SCALING_BRDF_F, SCALING_BRDF_F_0 )

!  Version 2p8p1. Patch Overhaul. Code is more compact.
!     !@@ Rob Fix, 11/1/19. Used the Dot-Product command throughout.

!   7/28/21. Have to introduce the Half-range flag here.

!  include file of dimensions and numbers

      USE VLIDORT_PARS_m, Only : MAXSTREAMS_BRDF, MAXSTREAMS_SCALING, ZERO, ONE, TWO, HALF

      IMPLICIT NONE

!  Prepares Fourier component of the bidirectional reflectance functions, (1,1) element for aling albedos

!  Input arguments
!  ===============

!  Local flags

      LOGICAL ::          DO_LOCAL_WSA, DO_LOCAL_BSA

!  Control

      LOGICAL ::          LAMBERTIAN_FLAG

!  7/28/21. Introduce Half-range flag

      LOGICAL ::          DO_HALF_RANGE

!  Local numbers

      INTEGER ::          SCALING_NSTREAMS, NSTREAMS_BRDF

!  Azimuth weights

      DOUBLE PRECISION :: A_BRDF ( MAXSTREAMS_BRDF )

!  Input for WSA/BSA scaling options. New, Version 2.7

      DOUBLE PRECISION :: SCALING_BRDFUNC   ( MAXSTREAMS_SCALING, MAXSTREAMS_SCALING, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: SCALING_BRDFUNC_0 ( MAXSTREAMS_SCALING, MAXSTREAMS_BRDF )

!  Output: Local kernel Fourier components
!  =======================================

!  at quadrature (discrete ordinate) angles

      DOUBLE PRECISION :: SCALING_BRDF_F   ( MAXSTREAMS_SCALING, MAXSTREAMS_SCALING )
      DOUBLE PRECISION :: SCALING_BRDF_F_0 ( MAXSTREAMS_SCALING   )

!  local variables
!  ===============

      INTEGER ::          I, J 
      DOUBLE PRECISION :: HELP

!  Zeroing

      SCALING_BRDF_F        = ZERO
      SCALING_BRDF_F_0      = ZERO

!  surface factor
!   -- 7/28/21. set to half the value if you are using the full-range azimuth integration

      if ( DO_HALF_RANGE ) THEN
         HELP = ONE
      else
         HELP = HALF
      endif

!  Quadrature outgoing directions
!  ------------------------------

!  BSA: Incident Solar beam

      IF ( DO_LOCAL_BSA ) THEN
         IF ( .NOT. LAMBERTIAN_FLAG ) THEN
            DO I = 1, SCALING_NSTREAMS
               SCALING_BRDF_F_0(I) = HELP * DOT_PRODUCT(SCALING_BRDFUNC_0(I,1:NSTREAMS_BRDF),A_BRDF(1:NSTREAMS_BRDF))
            ENDDO
         ELSE
            SCALING_BRDF_F_0 = ONE
         ENDIF
      ENDIF

!  WSA: incident quadrature directions

      if ( DO_LOCAL_WSA ) THEN
         IF ( .NOT. LAMBERTIAN_FLAG ) THEN
            DO I = 1, SCALING_NSTREAMS
               DO J = 1, SCALING_NSTREAMS
                  SCALING_BRDF_F(I,J) = HELP * DOT_PRODUCT(SCALING_BRDFUNC(I,J,1:NSTREAMS_BRDF),A_BRDF(1:NSTREAMS_BRDF))
               ENDDO
            ENDDO
         ELSE 
            SCALING_BRDF_F = ONE
         ENDIF
      ENDIF

!  Finish

      RETURN
      END SUBROUTINE SCALING_FOURIER_ZERO

!  

      SUBROUTINE VBRDF_FOURIER &
         ( DO_SOLAR_SOURCES, DO_USER_OBSGEOMS, DO_USER_STREAMS, DO_SURFEMISS, LAMBERTIAN_FLAG,   & ! Control flags
           DO_HALF_RANGE, DO_FOURIER_USERSUN, M, NSTOKES, NBEAMS, NSTREAMS, N_USER_STREAMS,      & ! Numbers
           NSTREAMS_BRDF, NBRDF_HALF, DELFAC, BRDF_COSAZMFAC, BRDF_SINAZMFAC, A_BRDF, BAX_BRDF,  & ! Surface/Azimuth factors
           BRDFUNC, USER_BRDFUNC, BRDFUNC_0, USER_BRDFUNC_0, EBRDFUNC, USER_EBRDFUNC,            & ! Input BRDF matrices
           L_BRDF_F, L_BRDF_F_0, L_USER_BRDF_F, L_USER_BRDF_F_0, L_EMISSIVITY, L_USER_EMISSIVITY ) ! Output Fourier Components

!  Version 2p8p1. Overhaul. 2019. Code is more compact.
!     !@@ Rob Fix, 3/20/19. Bug: Lambertian case wrongly used NSTOKESSQ instead of 1
!     !@@ Rob Fix, 11/1/19. Bug: Cossin_Mask wrongly used, code replaced. Thanks to X.Xu (UMBC)
!     !@@ Rob Fix, 11/1/19. Recoded the BRDF emissivity case
!     !@@ Rob Fix, 11/1/19. Used the Dot-Product command throughout. NSTOKESSQ Dropped.

!  7/28/21. Version 2.8.3. Some Changes
!    -- Half-Range azimuth integration introduced, now the default option. Controlled by parameter setting
!    -- Adjustment of +/- signs in Fourier-component sine-series settings. Validates against TestBed
!    -- MAXSTHALF_BRDF Dimensioning for CXE/SXE/EBRDFUNC/USER_EBRDFUNC/D_EBRDFUNC/D_USER_EBRDFUNC arrays, replaced by MAXSTREAMS_BRDF

!  2/25/22. Version 2.8.5.  Include flag DO_FOURIER_USERSUN for calculation of USER_BRDF_F_0. 

!  3/28/22, Kernel FACTOR argument has been dropped. 
!       -- [Was only required for emission, factor now deployed outside this routine]

!  include file of dimensions and numbers
!    -- MAXSTHALF_BRDF Dimensioning dropped

      USE VLIDORT_PARS_m, Only : MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS, MAXBEAMS, &
                                 MAXSTOKES, MAXSTREAMS_BRDF, ZERO, HALF, ONE, TWO

      IMPLICIT NONE

!  Prepares Fourier component of the bidirectional reflectance functions

!  Observational Geometry Inputs. Marked with !@@
!     Installed 31 december 2012.
!     Observation-Geometry input control.         (DO_USER_OBSGEOMS)
!     Added solar_sources flag for better control (DO_SOLAR_SOURCES)

!  Input arguments
!  ===============

!  Control flags
!   !@@ Solar sources + Observational Geometry flag !@@

      LOGICAL ::          DO_SOLAR_SOURCES
      LOGICAL ::          DO_USER_OBSGEOMS
      LOGICAL ::          LAMBERTIAN_FLAG
      LOGICAL ::          DO_USER_STREAMS
      LOGICAL ::          DO_SURFEMISS

!  7/28/21. Introduce Half-Range flag for control of azimuth integration

      LOGICAL ::          DO_HALF_RANGE

!  2/25/22. Version 2.8.5.  Include flag DO_FOURIER_USERSUN for calculation of USER_BRDF_F_0. 

      LOGICAL ::          DO_FOURIER_USERSUN

!  Local numbers

      INTEGER ::          M, NSTOKES, NSTREAMS
      INTEGER ::          NBEAMS, N_USER_STREAMS
      INTEGER ::          NSTREAMS_BRDF, NBRDF_HALF

!  Surface factor. 3/28/22, Kernel FACTOR argument has been dropped.

      DOUBLE PRECISION :: DELFAC

!  Azimuth cosines/sines and weights

      DOUBLE PRECISION :: BRDF_COSAZMFAC ( MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: BRDF_SINAZMFAC ( MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: A_BRDF         ( MAXSTREAMS_BRDF )

!  7/28/21. Necessary now to use MAXSTREAMS_BRDF here instead of MAXSTHALF_BRDF

      DOUBLE PRECISION :: BAX_BRDF       ( MAXSTREAMS_BRDF  )

!  at quadrature (discrete ordinate) angles

      DOUBLE PRECISION :: BRDFUNC   ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: BRDFUNC_0 ( MAXSTOKES_SQ, MAXSTREAMS, MAXBEAMS,   MAXSTREAMS_BRDF )

!  at user-defined stream directions

      DOUBLE PRECISION :: USER_BRDFUNC   ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS, MAXSTREAMS_BRDF )
      DOUBLE PRECISION :: USER_BRDFUNC_0 ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXBEAMS,   MAXSTREAMS_BRDF )

!  Values for Emissivity
!  7/28/21. Necessary now to use MAXSTREAMS_BRDF here instead of MAXSTHALF_BRDF

      DOUBLE PRECISION :: EBRDFUNC      ( MAXSTOKES_SQ, MAXSTREAMS,       MAXSTREAMS_BRDF, MAXSTREAMS_BRDF)
      DOUBLE PRECISION :: USER_EBRDFUNC ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS_BRDF, MAXSTREAMS_BRDF)

!  Output: Local kernel Fourier components
!  =======================================

!  at quadrature (discrete ordinate) angles

      DOUBLE PRECISION :: L_BRDF_F   ( MAXSTOKES_SQ, MAXSTREAMS, MAXSTREAMS )
      DOUBLE PRECISION :: L_BRDF_F_0 ( MAXSTOKES_SQ, MAXSTREAMS, MAXBEAMS   )

!  at user-defined stream directions

      DOUBLE PRECISION :: L_USER_BRDF_F   ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXSTREAMS )
      DOUBLE PRECISION :: L_USER_BRDF_F_0 ( MAXSTOKES_SQ, MAX_USER_STREAMS, MAXBEAMS   )

!  emissivities

      DOUBLE PRECISION :: L_EMISSIVITY      ( MAXSTOKES, MAXSTREAMS )
      DOUBLE PRECISION :: L_USER_EMISSIVITY ( MAXSTOKES, MAX_USER_STREAMS )

!  local variables
!  ===============

!  11/1/19. Some new local variables

      INTEGER ::          I, UI, J, KPHI, IB, Q, O1, O2, OM, OOFF(4), NK, NK2
      DOUBLE PRECISION :: REFL, HELP, HELPC, HELPS, HELP_EMISS, EMISS(4) ! EMISS(16)
      INTEGER ::          COSSIN_MASK(16)

      INTEGER, PARAMETER :: LUM = 1 

!      INTEGER ::          K
!      DOUBLE PRECISION :: BSUM

!  define cos/sin mask
!   -- 7/28/21. IMPORTANT. Define mask with 3 entries now.

  !    COSSIN_MASK = (/ 1,1,2,0,1,1,2,0,2,2,1,0,0,0,0,1 /)
      COSSIN_MASK = (/ 1,1,2,0,1,1,2,0,3,3,1,0,0,0,0,1 /)

!  surface factor
!   -- 7/28/21. set to half the value if you are using the full-range azimuth integration
!   -- 7/28/21. Set the emission help-factor ( HELP_EMISS = 2 for the half-range, 1 for the full-range)

      if ( DO_HALF_RANGE ) THEN
         HELP       = DELFAC   ! Alternative
         HELP_EMISS = TWO * DELFAC
      else
         HELP       = HALF * DELFAC
         HELP_EMISS = DELFAC
      endif

!   -- 7/28/21. Introduce +/- signs for cosine/sine

      HELPC = + HELP
      HELPS = - HELP

!  11/1/19. Proxies and offset. New Code.
!   --7/28/21. use NK2 = NBRDF_HALF for full-range, NK2 = NSTREAMS_BRDF for half-range azimuth integration

      NK = NSTREAMS_BRDF ; NK2 = NSTREAMS_BRDF ; if (.not. DO_HALF_RANGE ) NK2 = NBRDF_HALF
      OOFF(1) = 0 ; OOFF(2) = 4 ; OOFF(3) = 8 ; OOFF(4) = 12

!  Zeroing

      L_BRDF_F        = ZERO
      L_BRDF_F_0      = ZERO
      L_USER_BRDF_F   = ZERO
      L_USER_BRDF_F_0 = ZERO

!  Quadrature outgoing directions
!  ------------------------------

!  Incident Solar beam (direct beam reflections)
!     !@@ Solar Optionality, added 12/31/12
!     !@@ Rob Fix, 3/20/19. Bug: Lambertian case wrongly used NSTOKESSQ instead of 1
!     !@@ Rob Fix, 11/1/19. Bug: Cosine Mask wrongly used, code replaced. Thanks to X.Xu (UMBC)

!   --7/28/21. IMPORTANT. Cosine Mask now has 3 possibilities.

      IF ( DO_SOLAR_SOURCES ) THEN
        IF ( .NOT. LAMBERTIAN_FLAG ) THEN
          DO IB = 1, NBEAMS
            DO I = 1, NSTREAMS
!  Start Replacement code --------------------------------
              DO O1 = 1, NSTOKES
                DO O2 = 1, NSTOKES
                  OM = OOFF(O1) + O2
                  IF ( COSSIN_MASK(OM) .EQ. 1 ) THEN
                    L_BRDF_F_0(OM,I,IB) = HELPC * DOT_PRODUCT(BRDFUNC_0(OM,I,IB,1:NK),BRDF_COSAZMFAC(1:NK))
                  ELSE IF ( COSSIN_MASK(OM) .EQ. 2 ) THEN
                    L_BRDF_F_0(OM,I,IB) = HELPS * DOT_PRODUCT(BRDFUNC_0(OM,I,IB,1:NK),BRDF_SINAZMFAC(1:NK))
                  ELSE IF ( COSSIN_MASK(OM) .EQ. 3 ) THEN
                    L_BRDF_F_0(OM,I,IB) = - HELPS * DOT_PRODUCT(BRDFUNC_0(OM,I,IB,1:NK),BRDF_SINAZMFAC(1:NK))
                  ENDIF
                ENDDO
              ENDDO
!  End Replacement code ---------------------------------
            ENDDO
          ENDDO
        ELSE IF ( M .EQ. 0 ) THEN
          DO IB = 1, NBEAMS
            DO I = 1, NSTREAMS
              Q = 1 ; L_BRDF_F_0(Q,I,IB) = ONE ! 3/20/19 --> L_BRDF_F_0(1:NSTOKESSQ,I,IB) = ONE
            ENDDO
          ENDDO
        ENDIF
      ENDIF

!  incident quadrature directions (surface multiple reflections)
!     !@@ Rob Fix, 3/20/19. Bug: Lambertian case wrongly used NSTOKESSQ instead of 1
!     !@@ Rob Fix, 11/1/19. Bug: Cosine Mask wrongly used, code replaced. Thanks to X.Xu (UMBC)

!   --7/28/21. IMPORTANT. Cosine Mask now has 3 possibilities.

      IF ( .NOT. LAMBERTIAN_FLAG ) THEN
         DO I = 1, NSTREAMS
            DO J = 1, NSTREAMS
!  Start Replacement code --------------------------------
               DO O1 = 1, NSTOKES
                  DO O2 = 1, NSTOKES
                     OM = OOFF(O1) + O2
                     IF ( COSSIN_MASK(OM) .EQ. 1 ) THEN
                        L_BRDF_F(OM,I,J) = HELPC * DOT_PRODUCT(BRDFUNC(OM,I,J,1:NK),BRDF_COSAZMFAC(1:NK))
                     ELSE IF ( COSSIN_MASK(OM) .EQ. 2 ) THEN
                        L_BRDF_F(OM,I,J) = HELPS * DOT_PRODUCT(BRDFUNC(OM,I,J,1:NK),BRDF_SINAZMFAC(1:NK))
                     ELSE IF ( COSSIN_MASK(OM) .EQ. 3 ) THEN
                        L_BRDF_F(OM,I,J) = - HELPS * DOT_PRODUCT(BRDFUNC(OM,I,J,1:NK),BRDF_SINAZMFAC(1:NK))
                     ENDIF
                  ENDDO
               ENDDO
!  End Replacement code ---------------------------------
            ENDDO
         ENDDO
      ELSE IF ( M .EQ. 0 ) THEN
         DO I = 1, NSTREAMS
            DO J = 1, NSTREAMS
               Q = 1 ; L_BRDF_F(Q,I,J) = ONE ! 3/20/19 --> L_BRDF_F(1:NSTOKESSQ,I,J) = ONE
            ENDDO
         ENDDO
      ENDIF

!  debug information

!      IF ( DO_DEBUG_WRITE ) THEN
!        WRITE(555,'(A)')'BRDF_1 Fourier 0 quad values'
!        IF ( FOURIER .EQ. 0 ) THEN
!          DO I = 1, NSTREAMS
!          WRITE(555,'(1PE12.5,3x,1P10E12.5)') BIREFLEC_0(1,I,1),(BIREFLEC(1,I,J),J=1,NSTREAMS)
!         ENDDO
!        ENDIF
!      ENDIF

!  albedo check, always calculate the spherical albedo.
!   (Plane albedo calculations are commented out)

!  User-streams outgoing directions
!  --------------------------------

      IF ( DO_USER_STREAMS ) THEN

!  Incident Solar beam (direct beam reflections)
!     !@@ Observational Geometry option and Solar Optionality, Installed 12/31/12
!     !@@ Rob Fix, 3/20/19. Bug: Lambertian case wrongly used NSTOKESSQ instead of 1
!     !@@ Rob Fix, 11/1/19. Bug: Cosine Mask wrongly used, code replaced. Thanks to X.Xu (UMBC)

!   --7/28/21. IMPORTANT. Cosine Mask now has 3 possibilities.

!  2/25/22. Version 2.8.5. include flag for calculation of USER_BRDF_F_0.

        IF ( DO_SOLAR_SOURCES .and. DO_FOURIER_USERSUN ) THEN
          IF ( DO_USER_OBSGEOMS ) THEN
            IF ( .NOT. LAMBERTIAN_FLAG ) THEN
              DO IB = 1, NBEAMS
!  Start Replacement code --------------------------------
                DO O1 = 1, NSTOKES ; DO O2 = 1, NSTOKES
                  OM = OOFF(O1) + O2
                  IF ( COSSIN_MASK(OM) .EQ. 1 ) THEN
                    L_USER_BRDF_F_0(OM,LUM,IB) = HELPC * DOT_PRODUCT(USER_BRDFUNC_0(OM,LUM,IB,1:NK),BRDF_COSAZMFAC(1:NK))
                  ELSE IF ( COSSIN_MASK(OM) .EQ. 2 ) THEN
                    L_USER_BRDF_F_0(OM,LUM,IB) = HELPS * DOT_PRODUCT(USER_BRDFUNC_0(OM,LUM,IB,1:NK),BRDF_SINAZMFAC(1:NK))
                  ELSE IF ( COSSIN_MASK(OM) .EQ. 3 ) THEN
                    L_USER_BRDF_F_0(OM,LUM,IB) = - HELPS * DOT_PRODUCT(USER_BRDFUNC_0(OM,LUM,IB,1:NK),BRDF_SINAZMFAC(1:NK))
                  ENDIF
                  ENDDO ; ENDDO
!  End Replacement code ---------------------------------
              ENDDO
            ELSE IF ( M .EQ. 0 ) THEN
              DO IB = 1, NBEAMS
                Q = 1 ; L_USER_BRDF_F_0(Q,LUM,IB) = ONE ! 3/20/19 --> L_USER_BRDF_F_0(1:NSTOKESSQ,LUM,IB) = ONE 
              ENDDO
            ENDIF
          ELSE
            IF ( .NOT. LAMBERTIAN_FLAG ) THEN
              DO IB = 1, NBEAMS
                DO UI = 1, N_USER_STREAMS
!  Start Replacement code --------------------------------
                  DO O1 = 1, NSTOKES ; DO O2 = 1, NSTOKES
                    OM = OOFF(O1) + O2
                    IF ( COSSIN_MASK(OM) .EQ. 1 ) THEN
                      L_USER_BRDF_F_0(OM,UI,IB) = HELPC * DOT_PRODUCT(USER_BRDFUNC_0(OM,UI,IB,1:NK),BRDF_COSAZMFAC(1:NK))
                    ELSE IF ( COSSIN_MASK(OM) .EQ. 2 ) THEN
                      L_USER_BRDF_F_0(OM,UI,IB) = HELPS * DOT_PRODUCT(USER_BRDFUNC_0(OM,UI,IB,1:NK),BRDF_SINAZMFAC(1:NK))
                    ELSE IF ( COSSIN_MASK(OM) .EQ. 3 ) THEN
                      L_USER_BRDF_F_0(OM,UI,IB) = - HELPS * DOT_PRODUCT(USER_BRDFUNC_0(OM,UI,IB,1:NK),BRDF_SINAZMFAC(1:NK))
                    ENDIF
                  ENDDO ; ENDDO
!  End Replacement code ---------------------------------
                ENDDO
              ENDDO
            ELSE IF ( M .EQ. 0 ) THEN
              DO IB = 1, NBEAMS
                DO UI = 1, N_USER_STREAMS
                  Q = 1 ; L_USER_BRDF_F_0(Q,UI,IB) = ONE !  3/20/19 --> L_USER_BRDF_F_0(1:NSTOKESSQ,UI,IB) = ONE
                ENDDO
              ENDDO
            ENDIF
          ENDIF
        ENDIF

!  incident quadrature directions (surface multiple reflections)
!     !@@ Rob Fix, 3/20/19. Bug: Lambertian case wrongly used NSTOKESSQ instead of 1
!     !@@ Rob Fix, 11/1/19. Bug: Cosine Mask wrongly used, code replaced. Thanks to X.Xu (UMBC)

!   --7/28/21. IMPORTANT. Cosine Mask now has 3 possibilities.

        IF ( .NOT. LAMBERTIAN_FLAG ) THEN
          DO UI = 1, N_USER_STREAMS
            DO J = 1, NSTREAMS
!  Start Replacement code --------------------------------
              DO O1 = 1, NSTOKES ; DO O2 = 1, NSTOKES
                OM = OOFF(O1) + O2
                IF ( COSSIN_MASK(OM) .EQ. 1 ) THEN
                  L_USER_BRDF_F(OM,UI,J) = HELPC * DOT_PRODUCT(USER_BRDFUNC(OM,UI,J,1:NK),BRDF_COSAZMFAC(1:NK))
                ELSE IF ( COSSIN_MASK(OM) .EQ. 2 ) THEN
                  L_USER_BRDF_F(OM,UI,J) = HELPS * DOT_PRODUCT(USER_BRDFUNC(OM,UI,J,1:NK),BRDF_SINAZMFAC(1:NK))
                ELSE IF ( COSSIN_MASK(OM) .EQ. 3 ) THEN
                  L_USER_BRDF_F(OM,UI,J) = - HELPS * DOT_PRODUCT(USER_BRDFUNC(OM,UI,J,1:NK),BRDF_SINAZMFAC(1:NK))
                ENDIF
              ENDDO ; ENDDO
!  End Replacement code ---------------------------------
            ENDDO
          ENDDO
        ELSE IF ( M .EQ. 0 ) THEN
          DO UI = 1, N_USER_STREAMS
            DO J = 1, NSTREAMS
              Q = 1 ; L_USER_BRDF_F(Q,UI,J) = ONE ! 3/20/19 --> L_USER_BRDF_F(1:NSTOKESSQ,UI,J) = ONE
            ENDDO
          ENDDO
        ENDIF

!  End user-stream clause

      ENDIF

!  Emissivity
!  ----------

!  3/28/22. Remove Kernel factor from the emissivity definitions.

!  Azimuth independent contribution, from Kirchhoff's law

      IF ( DO_SURFEMISS .AND. M .EQ. 0 ) THEN

!  Lambertian case

        IF ( LAMBERTIAN_FLAG ) THEN
          DO I = 1, NSTREAMS
            L_EMISSIVITY(1,I) = ONE
          ENDDO
          IF ( DO_USER_STREAMS ) THEN
            DO UI = 1, N_USER_STREAMS
              L_USER_EMISSIVITY(1,UI) = ONE
            ENDDO
          ENDIF
        ENDIF

!  bidirectional reflectance

        IF ( .NOT. LAMBERTIAN_FLAG ) THEN

!  Inserted Polarization sum here.   Still to be checked.....!!!!!!!
!     !@@ Rob Fix, 11/1/19. Recoded the BRDF emissivity case

!     !@@ Rob Fix, 11/1/19. Bug: Cosine Mask wrongly used, code replaced. Thanks to X.Xu (UMBC)

!   --7/28/21. IMPORTANT. NK2 = NSTREAMS_BRDF for the HALF_SPACE case.

!  Quadrature polar directions

!mick fix
          EMISS = ZERO

          DO I = 1, NSTREAMS
!  Start Replacement code --------------------------------
            DO O1 = 1, NSTOKES
              DO O2 = 1, NSTOKES
                OM = OOFF(O1) + O2
                REFL = ZERO
                DO KPHI = 1, NSTREAMS_BRDF
                  REFL = REFL + A_BRDF(KPHI) * DOT_PRODUCT(EBRDFUNC(OM,I,1:NK2,KPHI),BAX_BRDF(1:NK2))
                ENDDO
                EMISS(O2) = REFL
              ENDDO
              L_EMISSIVITY(O1,I) = HELP_EMISS * SUM(EMISS(1:NSTOKES))
            ENDDO
!  End Replacement code ---------------------------------

          ENDDO

!  User-defined polar directions

          IF ( DO_USER_STREAMS ) THEN
            DO UI = 1, N_USER_STREAMS
!  Start Replacement code --------------------------------
              DO O1 = 1, NSTOKES
                DO O2 = 1, NSTOKES
                  OM = OOFF(O1) + O2
                  REFL = ZERO
                  DO KPHI = 1, NSTREAMS_BRDF
                    REFL = REFL + A_BRDF(KPHI) * DOT_PRODUCT(USER_EBRDFUNC(OM,UI,1:NK2,KPHI),BAX_BRDF(1:NK2))
                  ENDDO
                  EMISS(O2) = REFL
                ENDDO
                L_USER_EMISSIVITY(O1,UI) = HELP_EMISS * SUM(EMISS(1:NSTOKES))
              ENDDO
!  End Replacement code ---------------------------------
            ENDDO
          ENDIF

        ENDIF

!  End emissivity clause

      ENDIF

!  Finish

      RETURN
      END SUBROUTINE VBRDF_FOURIER

!  End module

      END MODULE vbrdf_sup_makerfourier_routines_m

