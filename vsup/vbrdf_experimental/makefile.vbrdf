   $(VBRDF_PATH)/vbrdf_sup_makerfourier_routines.f90	  \
   $(VBRDF_PATH)/vbrdf_sup_masters.f90	  \
   $(VBRDF_PATH)/vbrdf_sup_mod.f90	  

