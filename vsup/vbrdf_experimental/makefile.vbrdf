VBRDF_SUP_SOURCES +=   \
   $(BASE_SOURCES) \
   $(VBRDF_PATH)/vbrdf_findpar.f90	  \
   $(VBRDF_PATH)/vbrdf_sup_inputs_def.f90 \
   $(VBRDF_PATH)/vbrdf_sup_core_def.f90\
   $(VBRDF_PATH)/vbrdf_sup_outputs_def.f90\
   $(VBRDF_PATH)/vbrdf_sup_aux.f90	  \
