# Define the library
#

AR      = ar
ARFLAGS = crvs
RANLIB  = ranlib
LIBNAME = vlidort
LIBRARY = lib$(LIBNAME).a
PREFIX = .
LIBDIR = $(PREFIX)/lib \
       $(PREFIX)/include 

TMPDIR = $(MOD_PATH) $(OBJ_PATH) 

# Define main test program
main = pcrtm_omps_simulator_main

all: $(TMPDIR) $(LIBNAME)

test : $(LIBRARY) $(main)
$(LIBNAME) : $(TMPDIR) $(LIBRARY) 

$(main): $(VLID_TEST_PATH)/$(main).o
	$(FC) $< -o $@  $(LIBRARY)

# make main object files
$(VLID_TEST_PATH)/%.o : %.f90
	$(FC) $(FFLAGS) $< -o $@ 
	
$(LIBRARY): $(VLIDORT_OBJECTS)
	@echo $(VLIDORT_SOURCES_F90)
	$(AR) $(ARFLAGS) $@ $(VLIDORT_OBJECTS)
	$(RANLIB) $@

# make lib object files
$(OBJ_PATH)/%.o : %.f90
	$(FC) $(FFLAGS) $< -o $@ 

install: $(LIBDIR) $(LIBRARY)
	@echo; echo "Installing vlidort library .....  "
	@echo; echo "PREFIX=$(PREFIX) "
	@echo; cp ./$(LIBRARY) $(PREFIX)/lib 
	@echo; cp $(MOD_PATH)/*.mod  $(PREFIX)/include 

# ...Create directories if necessary
$(LIBDIR) $(TMPDIR) :
	- test -d $@ || mkdir -p  $@

.PHONY: clean
clean:
	rm -f *.o *.mod  *.log *.exe $(main) $(LIBRARY)
	rm -fr $(OBJ_PATH) $(MOD_PATH) $(PREFIX)/lib $(PREFIX)/include
	rm -f $(VLID_TEST_PATH)/*.o $(VLID_TEST_PATH)/*.mod

